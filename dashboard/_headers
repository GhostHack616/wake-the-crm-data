/
  Content-Type: text/html; charset=utf-8
/index.html
  Content-Type: text/html; charset=utf-8
/sphere/
  Content-Type: text/html; charset=utf-8
/sphere/index.html
  Content-Type: text/html; charset=utf-8
/wtc.json
  Content-Type: application/json; charset=utf-8
/tables/*
  Content-Type: application/json; charset=utf-8
  # 10 minutes, pas un an : les noms de fichiers ne portent pas d'empreinte,
  # donc « immutable » empêcherait toute correction d'être servie à quelqu'un
  # qui a déjà ouvert le tableau de bord.
  Cache-Control: public, max-age=600, must-revalidate
